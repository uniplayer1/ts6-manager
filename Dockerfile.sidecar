# syntax=docker/dockerfile:1.4
FROM golang:1.25-bookworm AS build
WORKDIR /src
COPY packages/sidecar/go.mod packages/sidecar/go.sum ./
RUN go mod download
COPY packages/sidecar/main.go .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /sidecar main.go

FROM alpine:3.21
# ffmpeg from Alpine (>= 8) fixes a segfault in Debian bookworm's ffmpeg 5.1.9
# that crashed on ANY HTTP-proxied input (video streams stayed black when routed
# through gluetun/NordVPN). Alpine ships a current ffmpeg that proxies cleanly.
RUN apk add --no-cache ffmpeg ca-certificates && \
    adduser -S -D -H -s /sbin/nologin sidecar
COPY --from=build /sidecar /usr/local/bin/sidecar
USER sidecar
# Inside a container the API must bind the bridge interface; never publish
# this port — the backend reaches it over the internal network.
ENV SIDECAR_LISTEN_ADDR=0.0.0.0
EXPOSE 9800
CMD ["sidecar"]
